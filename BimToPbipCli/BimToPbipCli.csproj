<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BimToPbipCli</RootNamespace>
    <AssemblyName>BimToPbipCli</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Tabular Object Model (TOM) for .NET. The converter deserializes the input
    .bim through TOM and re-serializes it as TMDL, which rebuilds a consistent
    object graph (see ConversionService). The package is Windows-x64, matching
    the -r win-x64 publish target, and is bundled into the self-contained .exe.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices.NetCore.retail.amd64" Version="19.*" />
  </ItemGroup>

  <!--
    The canonical PBIP metadata templates (../pbip-templates) are the single
    source of truth for the project's wrapper files, shared with the internal
    test. They are embedded so the published .exe is self-contained. The
    semantic model itself is NOT a template — it is generated by TOM.
    LogicalName is fixed so PbipTemplates can load them by a stable name.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../pbip-templates/project.pbip">
      <LogicalName>pbip-templates.project.pbip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../pbip-templates/SemanticModel/definition.pbism">
      <LogicalName>pbip-templates.SemanticModel.definition.pbism</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../pbip-templates/Report/definition.pbir">
      <LogicalName>pbip-templates.Report.definition.pbir</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../pbip-templates/Report/report.json">
      <LogicalName>pbip-templates.Report.report.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
